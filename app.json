{
  "expo": {
    "name": "La Cancha",
    "slug": "la-cancha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lacancha",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lacancha.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lacancha.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F0C"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "La Cancha necesita tu ubicación para mostrarte partidas cercanas.",
          "locationWhenInUsePermission": "La Cancha necesita tu ubicación para mostrarte partidas cercanas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "La Cancha necesita acceso a tus fotos para elegir foto de perfil y enviar imágenes en el chat.",
          "cameraPermission": "La Cancha necesita acceso a tu cámara para tomar fotos de perfil y enviarlas en el chat."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "303b62b0-5141-4cf8-931d-bb4121e186c2"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/303b62b0-5141-4cf8-931d-bb4121e186c2"
    }
  }
}
